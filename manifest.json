{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "32": "icons/icon32.png",
         "48": "icons/icon48.png"
      },
      "default_title": "Open Meta AI Automator"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content.js" ],
      "matches": [
         "https://meta.ai/*",
         "https://*.meta.ai/*"
      ]
   } ],
   "description": "A productivity assistant to streamline text-to-image or text-to-video generation on Meta Ai. Queue prompts to save time.",
   "host_permissions": [
      "https://meta.ai/*",
      "https://*.meta.ai/*"
   ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Meta Ai Automator",
   "permissions": [ "sidePanel", "activeTab", "downloads", "storage" ],
   "side_panel": {
      "default_path": "sidepanel.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.4.0"
}
